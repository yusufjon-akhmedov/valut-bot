# Database
DB_USERNAME=vault_user
DB_PASSWORD=vault_password

# Telegram Bot
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Allowed Users (comma-separated Telegram user IDs)
ALLOWED_USER_IDS=123456789,987654321

# Encryption (base64-encoded 32-byte AES-256 key)
# Generate with: openssl rand 32 | base64
CARD_ENCRYPTION_KEY=your_base64_encoded_32_byte_key_here
